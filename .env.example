# URL of the Nextcloud public share page that hosts the schedule .xlsx file
# (the page with the "Download" button, e.g. https://cloud.mirea.ru/index.php/s/XXXXXXXX).
SOURCE_URL=https://cloud.mirea.ru/index.php/s/fWbnJ6mFDMQEbD3

# How often (in seconds) the worker re-fetches the source and rebuilds the calendar.
POLL_INTERVAL_SECS=300

# Address the HTTP server binds to inside the container.
BIND_ADDR=0.0.0.0:8080

# Path the calendar is served at. Share this as the subscription URL, e.g.
# https://your-host/calendar.ics
CALENDAR_PATH=/calendar.ics

# Fixed UTC offset (hours) the dates/times in the spreadsheet are expressed in.
# 3 = Europe/Moscow (no DST observed).
TZ_OFFSET_HOURS=3

# Timeout for outbound HTTP requests (share page + xlsx download).
HTTP_TIMEOUT_SECS=30

# Calendar display name (NAME / X-WR-CALNAME), shown in calendar apps.
CALENDAR_NAME=Расписание

# Log verbosity: error|warn|info|debug|trace, or module-scoped filters.
RUST_LOG=info
